{
  "name": "patumwan-admin-ui",
  "private": true,
  "type": "module",
  "description": "หน้าแอดมิน /admin (เมนูด้านข้าง) และระบบผลการแข่งขัน /admin/results สร้างไฟล์ลง ../admin ด้วย npm run build และ npm run build:results",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node -e \"require('fs').rmSync('../admin/app',{recursive:true,force:true})\" && vite build",
    "build:results": "tsc --noEmit -p tsconfig.results.json && vite build --config vite.results.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "clsx": "2.1.1",
    "lucide-react": "0.525.0",
    "motion": "12.23.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@types/node": "22.16.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.7.0",
    "react-grab": "^0.2.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
